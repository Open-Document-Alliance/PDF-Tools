{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "npm install --omit=dev --no-audit --no-fund",
  "outputDirectory": "public",
  "functions": {
    "api/mcp.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/{@napi-rs/canvas*,pdfjs-dist}/**"
    },
    "api/mcp-connect.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/{@napi-rs/canvas*,pdfjs-dist}/**"
    },
    "api/connect-key.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/mcp/connect",
      "destination": "/api/mcp-connect"
    },
    {
      "source": "/connect",
      "destination": "/connect.html"
    }
  ]
}
