{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "npm install --omit=dev --no-audit --no-fund",
  "outputDirectory": "public",
  "functions": {
    "api/mcp.js": {
      "maxDuration": 60,
      "includeFiles": "{remote/**,server/**,node_modules/{@napi-rs/canvas*,pdfjs-dist}/**}"
    },
    "api/mcp-connect.js": {
      "maxDuration": 60,
      "includeFiles": "{remote/**,server/**,node_modules/{@napi-rs/canvas*,pdfjs-dist}/**}"
    },
    "api/connect-key.js": {
      "maxDuration": 10
    },
    "api/files-sweep.js": {
      "maxDuration": 60
    },
    "api/sign.js": {
      "maxDuration": 60,
      "includeFiles": "{package.json,remote/**,server/**,node_modules/{@napi-rs/canvas*,pdfjs-dist}/**}"
    }
  },
  "crons": [
    {
      "path": "/api/files-sweep",
      "schedule": "*/15 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/mcp/connect",
      "destination": "/api/mcp-connect"
    },
    {
      "source": "/connect",
      "destination": "/connect.html"
    },
    {
      "source": "/mcp/sign",
      "destination": "/api/sign?x-pdf-tools-path=/mcp/sign"
    },
    {
      "source": "/oauth/:path*",
      "destination": "/api/sign?x-pdf-tools-path=/oauth/:path*"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp/sign",
      "destination": "/api/sign?x-pdf-tools-path=/.well-known/oauth-protected-resource/mcp/sign"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/sign?x-pdf-tools-path=/.well-known/oauth-authorization-server"
    }
  ]
}
