*.pdf binary
*.wasm binary
.beads/issues.jsonl merge=ours

# Native contract tests bind selected JavaScript fixtures byte-for-byte. Keep
# their repository LF bytes stable when Git checks the suite out on Windows.
test/*.js text eol=lf
test/**/*.js text eol=lf

# The vendored QPDF WebAssembly runtime and its notices are byte-exact build
# output bound by vendor/qpdf-wasm/runtime.provenance.json. Any end-of-line or
# whitespace normalisation would break that hash contract, in the checkout and
# in the mirrored share tree alike.
vendor/qpdf-wasm/runtime/** -text -whitespace
pdf-toolkit-mcp-share/vendor/qpdf-wasm/runtime/** -text -whitespace

# The vendored PDFium Windows runtime (DLL binaries and the release's own
# bundled license notices) is likewise byte-exact and bound by
# vendor/pdfium/runtime.provenance.json and sources.lock.json.
vendor/pdfium/runtime/** -text -whitespace
vendor/pdfium/licenses/** -text -whitespace
pdf-toolkit-mcp-share/vendor/pdfium/runtime/** -text -whitespace
pdf-toolkit-mcp-share/vendor/pdfium/licenses/** -text -whitespace
