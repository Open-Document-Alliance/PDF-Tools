# Node modules.
# No trailing slash: agents and maintainers commonly symlink node_modules into
# an isolated worktree instead of installing a second copy, and a trailing
# slash matches directories only. The symlink then shows as untracked, which
# makes the eval campaign gates fail closed on a "dirty" worktree for a reason
# that has nothing to do with the campaign.
node_modules

# Build output
dist/

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

# Logs
*.log
npm-debug.log*

# Environment files
.env
.env.local

# Temporary files
*.tmp
*.temp
.test-tmp*/
.playwright-mcp/
*-sign.png

# Local planning artifacts
plans/*.local

# Private Claude context (business-sensitive notes)
.claude/
.agents/

# Legacy file (merged into CLAUDE.md)
AGENTS.md

# Build artifacts (attach to releases, don't commit)
pdf-toolkit-mcp.zip
*.mcpb

# Dolt database files (added by bd init)
.dolt/
*.db
windows-render-probe.json
dist-plugin/
.vercel
